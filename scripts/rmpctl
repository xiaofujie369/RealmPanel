#!/usr/bin/env bash
set -Eeuo pipefail
cd /opt/realm-panel
case ${1:-help} in
  status) docker compose ps ;;
  start) docker compose up -d ;;
  stop) docker compose stop ;;
  restart) docker compose restart; python3 scripts/healthcheck.py ;;
  logs) docker compose logs --tail=100 "${@:2}" ;;
  info) docker compose exec -T realm-panel-web python -m backend.cli info; python3 scripts/show-address.py "$(hostname -I | awk '{print $1}')" ;;
  reset-password|reset-path|backup) docker compose exec realm-panel-web python -m backend.cli "$@" ;;
  restore-full) docker compose stop realm-panel-web; docker compose run --rm --no-deps -T realm-panel-web python -m backend.cli restore-full "${@:2}"; docker compose up -d; python3 scripts/healthcheck.py ;;
  update) bash scripts/update.sh "${2:-latest}" ;;
  uninstall)
    echo '警告：此操作将卸载 RealmPanel。'
    echo '1. 仅卸载程序，保留数据'
    echo '2. 完全删除程序和所有数据'
    echo '0. 取消'
    read -r -p '请选择 [0]：' choice
    [[ $choice == 1 || $choice == 2 ]] || exit 0
    [[ $(pwd -P) == /opt/realm-panel && ! -L /opt/realm-panel ]] || { echo '目录安全检查失败'; exit 1; }
    docker compose down
    if [[ $choice == 2 ]]; then
      read -r -p '输入 DELETE 确认永久删除数据：' confirmation
      [[ $confirmation == DELETE ]] || exit 0
      rm -rf -- /opt/realm-panel
    else
      find /opt/realm-panel -mindepth 1 -maxdepth 1 ! -name data -exec rm -rf -- {} +
    fi
    rm -f /usr/local/bin/rmpctl
    echo '卸载完成。'
    ;;
  *) echo '用法：rmpctl {status|start|stop|restart|logs|info|reset-password|reset-path|backup|restore-full --file UUID|update [版本号]|uninstall}' ;;
esac
